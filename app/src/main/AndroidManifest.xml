<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- issue #15: lets EnclosureDownloadWorker promote itself to a foreground worker with a
         progress notification while an episode downloads. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ExoPlayer's WAKE_MODE_NETWORK (below) needs this to hold a CPU/Wi-Fi wake lock so a new
         episode's stream can actually open while the screen is off (issue #179). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets Settings prompt for exemption from Doze battery optimization (issue #273): even with
         the wake lock above, Doze can still defer/block network access for a non-exempt app in the
         gap right after an episode ends, intermittently breaking background auto-advance. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".MyCastsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyCasts"
        android:supportsRtl="true">

        <!-- issue #246: required for the app to be offered as a media source in Android Auto. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyCasts.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- issue #150: lets MyCasts appear in the share sheet when sharing a URL from
                 another app, to add it as a feed. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- issue #38: lets MyCasts appear in the share sheet when sharing an OPML file from
                 another app (e.g. exported from a different podcast app), and as a handler when
                 opening an .opml file directly (e.g. from a file manager or email attachment). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-opml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>
            <!-- Lint's AppLinkUrlError assumes any ACTION_VIEW + DEFAULT filter is a web deep
                 link needing a host/URL; this is a local file/mime-type filter, not a web link,
                 so that check doesn't apply here (tools:ignore below). -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-opml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- issue #246: legacy android.media.browse.MediaBrowserService action, required
                     for Android Auto's compatibility layer to recognize this as a browsable media
                     app, even though Media3's own discovery goes through the action above. -->
                <action android:name="android.media.browse.MediaBrowserService" />
                <!-- issue #246: lets Android Auto route a voice "play X" search here (real
                     handling of the search query itself is issue #248). -->
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <!-- issue #15: WorkManager's own SystemForegroundService needs this app's foreground
             service type declared explicitly for EnclosureDownloadWorker's setForeground() call. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <receiver
            android:name=".widget.UnreadWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/unread_widget_info" />
        </receiver>

        <!-- Wakes this app to apply an incoming position report from the watch (issue #276) even
             when it isn't already running; see PhoneSyncListenerService's own doc. Filtered by
             path (rather than the deprecated catch-all BIND_LISTENER) so the system only wakes
             this app for paths it actually handles. -->
        <service
            android:name=".sync.PhoneSyncListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/position" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disabled: MyCastsApp implements Configuration.Provider for Hilt-injected workers, so
             WorkManager initializes on-demand instead (see MyCastsApp.workManagerConfiguration). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
